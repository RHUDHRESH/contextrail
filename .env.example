# ContextRail — copy to .env for local runs. Production values come from AWS SSM Parameter Store.
# Never commit a filled-in copy: .githooks/pre-commit blocks .env files and credential shapes.
# A connector whose credentials are empty runs in FIXTURE mode and says so.

# --- core ---
DATABASE_URL=postgresql://cr:cr@postgres:5432/cr
PUBLIC_URL=https://contextrail.example.com
# Bearer token the FDK app and MCP clients present to the engine
ENGINE_TOKEN=change-me
# Local Next.js -> Python integration demo only (never expose the demo route publicly).
DEMO_ENGINE_URL=
# HMAC key for signed email/Teams decision links (/a/{token})
# At least 32 random characters (e.g. `openssl rand -hex 32`); links are switched off while it is change-me
DECISION_LINK_SECRET=change-me
LOG_LEVEL=INFO
LOG_JSON=true
# JSON list, e.g. ["https://yourtenant.freshservice.com"]
CORS_ALLOWED_ORIGINS=[]
# Local demo only: send fixture approvers' mail to real (SES-verified) inboxes. Never commit real addresses.
# Format: person_id=email,person_id=email   e.g. p-dana=you+dana@example.com
DEMO_EMAIL_OVERRIDES=
# Seed fixtures (read-only), mutable fixture state, OKF knowledge bundle. Empty = repo defaults.
FIXTURES_DIR=
STATE_DIR=
KNOWLEDGE_DIR=

# --- Freshservice (the base) / Freshdesk ---
FS_DOMAIN=yourtenant.freshservice.com
FS_API_KEY=
FS_WORKSPACE_ID=
FS_WEBHOOK_SECRET=
FS_RATE_LIMIT_PER_MIN=80
FD_DOMAIN=yourtenant.freshdesk.com
FD_API_KEY=

# --- LLM router: T1/T2 direct API, T3 Bedrock, T4 replay ---
ANTHROPIC_KEY_A=
ANTHROPIC_KEY_B=
AWS_REGION=ap-south-1
BEDROCK_HAIKU_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_SONNET_ID=
BEDROCK_BUDGET_USD=20
RUN_BUDGET_USD=0.50
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-5
# off | record | replay
LLM_REPLAY_MODE=off
# T3 is used only when enabled; Bedrock credentials come from the AWS default chain (env, profile, instance role)
BEDROCK_ENABLED=false
# Recorded T4 responses (JSON files). Empty = <fixtures>/llm_replay
LLM_REPLAY_DIR=

# --- Email door: inbound via the Freshservice mailbox, outbound via Amazon SES ---
SES_FROM_ADDRESS=contextrail@yourdomain.example
SES_CONFIGURATION_SET=
# SNS topic ARN for SES bounces/complaints; /v1/webhooks/ses rejects every message while this is empty
SES_SNS_TOPIC_ARN=

# --- Slack door ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Socket Mode (dev only)
SLACK_APP_TOKEN=

# --- Microsoft Teams door ---
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=
# ONE-WAY fallback: Teams Workflows incoming webhook
TEAMS_WORKFLOW_WEBHOOK_URL=

# --- Voice door (Vobiz x Sarvam) ---
SARVAM_API_KEY=
AGENT_LANGUAGE=hi-IN
TTS_SPEAKER=anand
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=

# --- Payments (P2, test mode) ---
# Dodo is pinned to https://test.dodopayments.com in code. Empty key = FIXTURE.
# The pilot's Dodo customer id (usage events) and the "ContextRail governed run" product id (checkout link)
DODO_CUSTOMER_ID=
DODO_PRODUCT_ID=
DODO_API_KEY=

# --- Job worker ---
# true: the API process also runs the job worker (one box; its stage events reach SSE). false: run
# `python -m contextrail.worker` as its own service.
WORKER_IN_PROCESS=true
