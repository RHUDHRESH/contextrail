# Voice door settings. In docker compose the root .env is loaded too; keys shared with the engine keep their names.
# Empty credentials run that part in FIXTURE mode and /health says so.

# Sarvam AI (Saaras v3 STT + Bulbul v3 TTS), sent as the api-subscription-key header
SARVAM_API_KEY=

# Phone dialogue uses Sarvam-105B Conversations through SARVAM_API_KEY; the engine may use Anthropic separately.

# ContextRail engine (the door contract over HTTP). Compose sets ENGINE_URL=http://engine:8000.
ENGINE_URL=http://localhost:8000
# Same bearer token the engine expects (root .env ENGINE_TOKEN). Empty or change-me = the door stays closed.
ENGINE_TOKEN=

# Vobiz account. Both values enable authenticated live-call read-back. The token alone verifies only callback URL
# signatures and never proves caller identity. Without the read-back, callers get policy questions only.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Reserved for future verified transfer. Paid transfer is disabled until callback actions can be bound to the call.
HUMAN_TRANSFER_NUMBER=

# Agent config (the system prompt is fixed in dialogue.py: it is a guardrail, not a setting)
# Default call language: hi-IN | en-IN | ta-IN | kn-IN (callers can switch by naming a language)
AGENT_LANGUAGE=hi-IN
# Optional bulbul:v3 voice for the default language only; each language has its own voice (languages.py)
TTS_SPEAKER=anand

# Server. Public base URL Vobiz calls (answer URL = <base>/answer); default PUBLIC_URL + /voice (the Caddy route)
VOICE_PUBLIC_URL=
HTTP_PORT=8100
