# ContextRail edge: automatic HTTPS for {$CR_HOST}. CLAUDE.md §19.
# Engine: API, MCP, Slack, Teams, signed decision links, receipts.  Voice: /voice/*.
{
	email {$CR_ACME_EMAIL:admin@example.com}
}

{$CR_HOST:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Voice door (Vobiz Answer URL + media WebSocket). Prefix stripped: the service serves /answer, /ws, /health.
	handle_path /voice/* {
		reverse_proxy voice:8100
	}

	# Engine: /v1 API + webhooks, /mcp (Streamable HTTP), /slack/* (Bolt HTTP mode),
	# /api/teams/* (Bot Framework messages), /a/* (signed decision links), /r/* (receipts), /health.
	handle {
		reverse_proxy engine:8000 {
			# SSE (/v1/runs/{id}/events) and MCP streaming must not be buffered.
			flush_interval -1
		}
	}

	log {
		output stdout
		format json
	}
}
