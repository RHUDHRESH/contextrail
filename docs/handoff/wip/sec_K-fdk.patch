diff --git a/fdk-app/tests/view-receipt.test.js b/fdk-app/tests/view-receipt.test.js
new file mode 100644
index 0000000..aa42777
--- /dev/null
+++ b/fdk-app/tests/view-receipt.test.js
@@ -0,0 +1,98 @@
+/**
+ * @vitest-environment jsdom
+ */
+// Footer actions (receipt, refresh), error-with-retry, and the receipt itself.
+
+let V;
+
+beforeEach(async () => {
+  vi.resetModules();
+  delete window.CRView;
+  await import('../app/scripts/view.js');
+  V = window.CRView;
+});
+
+describe('renderActions', () => {
+  test.each(['done', 'partial', 'failed'])('a %s run offers the receipt', (status) => {
+    const box = V.renderActions(document, { status }, false);
+    expect(box.querySelector('fw-button#cr-receipt').textContent).toBe('View receipt');
+    expect(box.querySelector('fw-button#cr-refresh')).toBeNull();
+  });
+
+  test.each(['awaiting_approval', 'needs_input'])('a %s run offers a manual refresh instead of polling', (status) => {
+    const box = V.renderActions(document, { status }, false);
+    expect(box.querySelector('fw-button#cr-refresh').textContent).toBe('Refresh');
+    expect(box.querySelector('fw-button#cr-receipt')).toBeNull();
+  });
+
+  test('a running run shows no buttons while it is being polled', () => {
+    expect(V.renderActions(document, { status: 'running' }, false).querySelector('fw-button')).toBeNull();
+  });
+
+  test('a run that is still running after the poll window says so and offers refresh', () => {
+    const box = V.renderActions(document, { status: 'running' }, true);
+    expect(box.querySelector('.cr-stalled').textContent).toMatch(/still running/i);
+    expect(box.querySelector('fw-button#cr-refresh')).not.toBeNull();
+  });
+});
+
+describe('renderError', () => {
+  test('shows the error and a Try again button', () => {
+    const box = V.renderError(document, 'The engine did not answer in time.');
+    expect(box.querySelector('fw-inline-message').getAttribute('type')).toBe('error');
+    expect(box.querySelector('fw-inline-message').textContent).toBe('The engine did not answer in time.');
+    expect(box.querySelector('fw-button#cr-retry').textContent).toBe('Try again');
+  });
+});
+
+describe('renderReceipt', () => {
+  const receipt = {
+    run_id: '3f2b6c1e-8d4a-4b7e-9c1a-2e5f7a9b0c3d',
+    summary: '13 granted and verified, 2 held, 1 refused (POL-CTR-001).',
+    audit_from: 12,
+    audit_to: 40,
+    fs_note_id: '9001',
+    fs_record_id: null,
+    created_at: '2026-09-26T11:30:00Z',
+    body: { counts: { allow: 13, hold: 2, refuse: 1 } }
+  };
+
+  test('shows the summary, the audit range and where the receipt lives', () => {
+    const box = V.renderReceipt(document, receipt);
+    expect(box.querySelector('.cr-receipt-summary').textContent).toBe(receipt.summary);
+    const facts = [...box.querySelectorAll('.cr-receipt-facts li')].map((li) => li.textContent);
+    expect(facts).toContain('Audit entries #12 to #40');
+    expect(facts).toContain('Private note 9001 on this ticket');
+    expect(facts).toContain('Custom object record: not written');
+  });
+
+  test('prints the full receipt JSON as text', () => {
+    const pre = V.renderReceipt(document, receipt).querySelector('pre.cr-receipt-json');
+    expect(JSON.parse(pre.textContent)).toEqual(receipt.body);
+  });
+
+  test('receipt text is inert', () => {
+    const box = V.renderReceipt(document, { ...receipt, summary: '<img src=x onerror=alert(1)>' });
+    expect(box.querySelector('img')).toBeNull();
+  });
+});
+
+describe('receiptErrorText', () => {
+  test('a missing receipt is explained, not reported as a failure', () => {
+    expect(V.receiptErrorText({ status: 404 })).toMatch(/no receipt yet/i);
+  });
+
+  test('a timeout and other failures name what happened', () => {
+    expect(V.receiptErrorText({ status: 504 })).toMatch(/did not answer in time/i);
+    expect(V.receiptErrorText({ status: 500 })).toContain('HTTP 500');
+  });
+});
+
+describe('isRunId', () => {
+  test('accepts a UUID and rejects anything that could change the request path', () => {
+    expect(V.isRunId('3f2b6c1e-8d4a-4b7e-9c1a-2e5f7a9b0c3d')).toBe(true);
+    expect(V.isRunId('../admin')).toBe(false);
+    expect(V.isRunId('3f2b6c1e-8d4a-4b7e-9c1a-2e5f7a9b0c3d/../x')).toBe(false);
+    expect(V.isRunId(undefined)).toBe(false);
+  });
+});
