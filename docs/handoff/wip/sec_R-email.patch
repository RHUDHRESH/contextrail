diff --git a/engine/tests/test_email_copy.py b/engine/tests/test_email_copy.py
new file mode 100644
index 0000000..2e9d723
--- /dev/null
+++ b/engine/tests/test_email_copy.py
@@ -0,0 +1,66 @@
+"""Copy pass for the email door (CLAUDE.md §13.1, §13.0, checklist T238): the same verbs and lamps as the Slack card
+("Approval needed · <action>", Action / Rule / Deadline, Approve / Refuse, "Decided by <who> in <door>"), lamps only
+from presenter.LAMP, and plain text that fits a phone screen."""
+
+import re
+from datetime import UTC, datetime
+
+from test_email_approval import APPROVE, REFUSE, a_view
+
+from contextrail.surfaces.decision_page import door_name
+from contextrail.surfaces.email import PHONE_WIDTH, render_approval_email, render_receipt_email
+from contextrail.surfaces.presenter import LAMP
+
+EMOJI = re.compile(r"[☀-➿\U0001F300-\U0001FAFF]")
+
+
+def approval():
+    view, row = a_view()
+    return render_approval_email(view, row, approve_url=APPROVE, refuse_url=REFUSE, delivery_mode="FIXTURE",
+                                 expires_at=datetime(2026, 9, 29, 11, 30, tzinfo=UTC))
+
+
+def receipt():
+    view, row = a_view()
+    refused = row.model_copy(update={"action_id": "A18", "verdict": "REFUSE", "lamp": LAMP["REFUSE"],
+                                     "state": "refused", "rule_id": "POL-ACC-003", "clause": "Seniors only.",
+                                     "label": "AWS payments-prod AdministratorAccess"})
+    done = row.model_copy(update={"action_id": "A01", "verdict": "ALLOW", "lamp": LAMP["ALLOW"],
+                                  "state": "verified", "label": "Slack workspace member"})
+    failed = done.model_copy(update={"action_id": "A02", "state": "failed", "label": "Jira"})
+    view = view.model_copy(update={"status": "partial", "rows": [done, failed, row, refused],
+                                   "counts": {"allow": 2, "hold": 1, "refuse": 1, "verified": 1, "awaiting": 1,
+                                              "failed": 1}})
+    return render_receipt_email(view, audit_from=1, audit_to=9, delivery_mode="FIXTURE")
+
+
+def test_the_subject_is_the_slack_card_header():
+    assert approval().subject == "Approval needed · Figma Professional seat"
+
+
+def test_the_approval_email_uses_the_slack_card_fields_and_verbs():
+    text = approval().text
+    assert text.startswith(f"{LAMP['HOLD']} Approval needed · Figma Professional seat\n")
+    for field in ("Action: ", "Rule: POL-ACC-005", "Deadline: 29 Sep 2026 17:00 IST"):
+        assert field in text, field
+    assert "\nApprove:\n" in text and "\nRefuse:\n" in text
+    assert ">Approve</a>" in approval().html and ">Refuse</a>" in approval().html
+
+
+def test_every_lamp_is_a_presenter_lamp():
+    lamps = set(LAMP.values())
+    for rendered in (approval(), receipt()):
+        assert set(EMOJI.findall(rendered.text)) <= lamps, EMOJI.findall(rendered.text)
+    assert {LAMP["ALLOW"], LAMP["HOLD"], LAMP["REFUSE"]} <= set(EMOJI.findall(receipt().text))
+
+
+def test_plain_text_fits_a_phone():
+    for rendered in (approval(), receipt()):
+        long = [line for line in rendered.text.splitlines()
+                if len(line) > PHONE_WIDTH and not line.startswith("https://")]
+        assert long == []
+
+
+def test_doors_are_named_the_way_people_say_them():
+    assert [door_name(c) for c in ("email", "slack", "teams", "voice", "freshservice", "mcp")] == [
+        "Email", "Slack", "Teams", "Voice", "Freshservice", "MCP"]
