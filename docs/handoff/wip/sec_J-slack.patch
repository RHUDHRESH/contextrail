diff --git a/engine/tests/test_slack_assistant.py b/engine/tests/test_slack_assistant.py
new file mode 100644
index 0000000..420f660
--- /dev/null
+++ b/engine/tests/test_slack_assistant.py
@@ -0,0 +1,78 @@
+"""The Slack AI assistant pane (CLAUDE.md §13.1, §15 X3): suggested prompts, requests typed in the pane, live stage
+status and the final summary. No network: FakeSlackClient records every Web API call."""
+
+import json
+
+import httpx
+import pytest
+from slack_fake import BOT_TOKEN, SIGNING_SECRET, FakeSlackClient, forbid_real_slack_calls, signed_headers
+
+from contextrail.fixtures import load
+from contextrail.main import create_app
+from contextrail.settings import Settings
+from contextrail.surfaces import slack_blocks as blocks
+from contextrail.surfaces.door import Door
+from contextrail.surfaces.slack_app import SlackDoor
+
+PEOPLE = {p["person_id"]: p["display_name"] for p in load("identity")["people"]}
+ANIL_SLACK, DM, THREAD = "U0ANIL001", "D0ANILDM1", "1790000100.000100"
+
+
+@pytest.fixture(autouse=True)
+def _no_network(monkeypatch):
+    forbid_real_slack_calls(monkeypatch)
+    for k in ("SLACK_BOT_TOKEN", "SLACK_SIGNING_SECRET", "SLACK_APP_TOKEN"):
+        monkeypatch.delenv(k, raising=False)
+
+
+@pytest.fixture
+async def door(rail):
+    runner, deps = rail
+    modes = {n: deps.registry.get(n).mode for n in ("hris", "entitlements", "github", "slack_corpus")}
+    return Door(runner, people=PEOPLE, modes=modes)
+
+
+@pytest.fixture
+def fake():
+    return FakeSlackClient()
+
+
+@pytest.fixture
+def slack(door, fake):
+    return SlackDoor(door, client=fake, signing_secret=SIGNING_SECRET, process_before_response=True)
+
+
+def _event(event: dict) -> dict:
+    return {"type": "event_callback", "team_id": "T0NORTH01", "api_app_id": "A0CONTEXT", "event_id": "Ev01",
+            "event_time": 1790000100, "event": event}
+
+
+THREAD_STARTED = _event({"type": "assistant_thread_started", "event_ts": "1790000100.000101",
+                         "assistant_thread": {"user_id": ANIL_SLACK, "channel_id": DM, "thread_ts": THREAD,
+                                              "context": {}}})
+
+
+async def _post_event(door, fake, body: dict) -> httpx.Response:
+    app = create_app(Settings(_env_file=None, slack_bot_token=BOT_TOKEN, slack_signing_secret=SIGNING_SECRET))
+    app.state.slack = SlackDoor(door, client=fake, signing_secret=SIGNING_SECRET, process_before_response=True)
+    raw = json.dumps(body)
+    async with httpx.AsyncClient(transport=httpx.ASGITransport(app=app), base_url="http://engine") as h:
+        return await h.post("/slack/events", content=raw, headers=signed_headers(raw, content_type="application/json"))
+
+
+# --- T143: a new assistant thread gets a greeting and the suggested prompts -----------------------------------------
+
+async def test_a_new_assistant_thread_gets_a_greeting_and_suggested_prompts(slack, fake):
+    await slack.on_thread_started(body=THREAD_STARTED)
+    [hello] = fake.called("chat.postMessage")
+    assert (hello["channel"], hello["thread_ts"]) == (DM, THREAD) and hello["text"] == blocks.ASSISTANT_HELLO
+    [prompts] = fake.called("assistant.threads.setSuggestedPrompts")
+    assert (prompts["channel_id"], prompts["thread_ts"]) == (DM, THREAD)
+    assert [p["title"] for p in prompts["prompts"]] == ["Same access as a teammate", "Onboard a new starter",
+                                                       "Why was this refused?"]
+
+
+async def test_the_thread_started_event_is_routed_by_bolt(door, fake):
+    r = await _post_event(door, fake, THREAD_STARTED)
+    assert r.status_code == 200
+    assert [m for m, _ in fake.calls] == ["auth.test", "chat.postMessage", "assistant.threads.setSuggestedPrompts"]
