diff --git a/engine/tests/test_deadlines.py b/engine/tests/test_deadlines.py
new file mode 100644
index 0000000..8dbac80
--- /dev/null
+++ b/engine/tests/test_deadlines.py
@@ -0,0 +1,217 @@
+"""Approval deadlines and chase jobs (checklist T101, CLAUDE.md §8 Approve "deadline job", §13.0 deadline, D-005).
+
+Expiry never decides: the action stays awaiting, a blocker is opened, and the audit says so.
+"""
+
+from collections import Counter
+from datetime import UTC, datetime, timedelta
+
+import pytest
+
+from contextrail import repo
+from contextrail.db import Database
+from contextrail.models import Action, CaseFile, RunStatus, Subject, Verdict, apply_verdict
+from contextrail.policy.schema import Rule
+from contextrail.rail import deadlines
+from contextrail.rail.deadlines import IST, approval_deadline, chase_time
+from contextrail.rail.store import load_case
+
+
+def ist(y, m, d, hh, mm=0):
+    return datetime(y, m, d, hh, mm, tzinfo=IST)
+
+
+EMERGENCY = Rule(id="POL-EMG-001", title="Incident access", source={"okf": "knowledge/runbooks/x.md", "clause": "§1"},
+                 clause_text="Incident access is read-only, time-boxed and approved by the incident commander.",
+                 match={"kind": "grant"}, verdict="HOLD", approver="incident-commander", expires_after="4h")
+
+
+# --- the deadline itself ------------------------------------------------------------------------------------
+
+@pytest.mark.parametrize("now, due", [
+    (ist(2026, 9, 28, 10), ist(2026, 9, 28, 17)),       # Monday morning -> today 17:00 IST
+    (ist(2026, 9, 28, 15, 30), ist(2026, 9, 29, 17)),   # under two hours left -> next business day
+    (ist(2026, 10, 2, 16), ist(2026, 10, 5, 17)),       # Friday afternoon -> Monday
+    (ist(2026, 9, 26, 9), ist(2026, 9, 28, 17)),        # Saturday -> Monday
+    (ist(2026, 9, 28, 20), ist(2026, 9, 29, 17)),       # after hours -> tomorrow
+])
+def test_default_deadline_is_the_end_of_the_business_day_in_ist(now, due):
+    got = approval_deadline(now.astimezone(UTC), None)
+    assert got == due and got.tzinfo is not None
+    assert chase_time(got, now) == due - timedelta(hours=1)
+
+
+def test_a_rules_expires_after_sets_the_deadline():
+    now = ist(2026, 9, 28, 10).astimezone(UTC)
+    assert approval_deadline(now, EMERGENCY) == now + timedelta(hours=4)
+    short = EMERGENCY.model_copy(update={"expires_after": "30m"})
+    assert chase_time(approval_deadline(now, short), now) is None  # no chase that would land in the past
+
+
+# --- scheduling -------------------------------------------------------------------------------------------------
+
+ANIL = Subject(source="hris", source_id="E-1042", display_name="Anil Kumar", employment_type="employee")
+
+
+def held(aid, rule_id="POL-ACC-005", approver="p-meera"):
+    a = Action.create(aid, "grant", {"entitlement": aid.lower(), "subject_id": "E-1042"})
+    return apply_verdict(a, Verdict(verdict="HOLD", rule_id=rule_id, clause_text="clause", approver=approver))
+
+
+@pytest.fixture
+async def run_id(migrated_db):
+    async with Database(migrated_db) as db, db.transaction() as c:
+        return (await repo.create_run(c, source="slack", request_text="x"))["id"]
+
+
+async def _jobs(db):
+    async with db.connection() as c:
+        return await (await c.execute("select kind, payload, run_at from jobs order by id")).fetchall()
+
+
+async def test_each_hold_gets_a_deadline_a_deadline_job_and_a_chase_job_once(migrated_db, run_id):
+    now = ist(2026, 9, 28, 10).astimezone(UTC)
+    case = CaseFile(run_id=run_id, request_text="x", intent="access.same_as_peer", subject=ANIL,
+                    actions=[held("A15"), held("A16", "POL-EMG-001", "p-omar"), held("A17", approver="role:manager")])
+    async with Database(migrated_db) as db:
+        async with db.transaction() as c:
+            first = await deadlines.schedule(c, case, rules=[EMERGENCY], now=now)
+        async with db.transaction() as c:
+            second = await deadlines.schedule(c, case, rules=[EMERGENCY], now=now + timedelta(minutes=5))
+        jobs = await _jobs(db)
+    assert first == {"A15": ist(2026, 9, 28, 17), "A16": now + timedelta(hours=4)} and second == {}
+    assert case.action("A15").expires_at == ist(2026, 9, 28, 17) and case.action("A17").expires_at is None
+    by = {(j["kind"], j["payload"]["action_id"]): j for j in jobs}
+    assert set(by) == {("approval.deadline", "A15"), ("approval.chase", "A15"),
+                       ("approval.deadline", "A16"), ("approval.chase", "A16")}
+    assert by[("approval.deadline", "A15")]["run_at"] == ist(2026, 9, 28, 17)
+    assert by[("approval.chase", "A15")]["run_at"] == ist(2026, 9, 28, 16)
+    assert by[("approval.chase", "A16")]["payload"]["approver"] == "p-omar"
+    assert all(len(j["payload"]["params_hash"]) == 64 for j in jobs)
+
+
+# --- handlers, against a real run ----------------------------------------------------------------------------
+
+async def _held_run(runner, deps):
+    rid = await runner.start(source="slack", request_text="Give Anil the same access as Rahul Mehta",
+                             requested_by="p-anil")
+    assert await runner.run(rid) is RunStatus.AWAITING_APPROVAL
+    async with deps.db.connection() as c:
+        holds = [a for a in await repo.list_actions(c, rid) if a["state"] == "awaiting"]
+    return rid, {a["approver"]: a for a in holds}
+
+
+def _payload(rid, a):
+    return {"run_id": str(rid), "action_id": a["id"], "params_hash": a["params_hash"], "approver": a["approver"],
+            "deadline": a["expires_at"].isoformat()}
+
+
+async def _audit(deps, rid, event):
+    async with deps.db.connection() as c:
+        return [r["payload"] for r in await (await c.execute(
+            "select payload from audit where run_id = %s and event = %s order by seq", (rid, event))).fetchall()]
+
+
+async def test_the_rail_sets_deadlines_schedules_jobs_and_shows_the_deadline(rail):
+    runner, deps = rail
+    rid, holds = await _held_run(runner, deps)
+    assert all(a["expires_at"] is not None for a in holds.values())
+    async with deps.db.connection() as c:
+        kinds = Counter(r["kind"] for r in await (await c.execute("select kind from jobs")).fetchall())
+        run = await repo.get_run(c, rid)
+    assert kinds["approval.deadline"] == 2 and kinds["approval.chase"] == 2
+    from contextrail.surfaces.presenter import build_view
+    async with deps.db.connection() as c:
+        view = build_view(run, await repo.list_actions(c, rid), people={}, modes={})
+    assert {r.deadline for r in view.rows if r.verdict == "HOLD"} == {a["expires_at"] for a in holds.values()}
+    assert all(r.deadline is None for r in view.rows if r.verdict != "HOLD")
+
+
+async def test_chase_goes_to_the_approvers_preferred_door(rail):
+    runner, deps = rail
+    rid, holds = await _held_run(runner, deps)
+    for approver, door in (("p-dana", "teams"), ("p-meera", "email")):
+        a = holds[approver]
+        async with deps.db.transaction() as c:
+            out = await deadlines.on_chase(c, _payload(rid, a), now=a["expires_at"] - timedelta(hours=1))
+        assert out == "chased"
+        async with deps.db.connection() as c:
+            job = await (await c.execute("select payload from jobs where kind = 'door.chase' and payload->>'action_id' = %s",
+                                         (a["id"],))).fetchone()
+        assert (job["payload"]["channel"], job["payload"]["approver"]) == (door, approver)
+    assert {p["channel"] for p in await _audit(deps, rid, "approval.chased")} == {"teams", "email"}
+
+
+async def test_no_chase_once_decided_or_past_the_deadline(rail):
+    runner, deps = rail
+    rid, holds = await _held_run(runner, deps)
+    dana, meera = holds["p-dana"], holds["p-meera"]
+    async with deps.db.transaction() as c:
+        await repo.record_approval(c, rid, dana["id"], params_hash=dana["params_hash"], approver="p-dana",
+                                   decision="approved", channel="teams")
+        assert await deadlines.on_chase(c, _payload(rid, dana), now=dana["expires_at"] - timedelta(hours=1)) == "decided"
+        assert await deadlines.on_chase(c, _payload(rid, meera), now=meera["expires_at"]) == "past_deadline"
+    assert await _audit(deps, rid, "approval.chased") == []
+
+
+async def test_expiry_leaves_the_action_awaiting_with_a_blocker_and_an_audit_entry(rail):
+    runner, deps = rail
+    rid, holds = await _held_run(runner, deps)
+    meera = holds["p-meera"]
+    after = meera["expires_at"] + timedelta(seconds=1)
+    async with deps.db.transaction() as c:
+        assert await deadlines.on_deadline(c, _payload(rid, meera), now=after) == "expired"
+    async with deps.db.transaction() as c:  # a retried job changes nothing more
+        assert await deadlines.on_deadline(c, _payload(rid, meera), now=after) == "already_expired"
+    async with deps.db.connection() as c:
+        run = await repo.get_run(c, rid)
+        action = {a["id"]: a for a in await repo.list_actions(c, rid)}[meera["id"]]
+        approval = await repo.get_approval(c, rid, meera["id"])
+        case = await load_case(c, rid)  # the capsule was re-sealed, and still verifies
