@@ -0,0 +1,181 @@
+"""Approval deadlines and chase jobs (checklist T101, CLAUDE.md §8 Approve: "deadline job").
+
+Every held action with a named approver gets a deadline, stored as `Action.expires_at`:
+- the deciding rule's `expires_after` when it has one (incident access is time-boxed, POL-EMG-001);
+- otherwise 17:00 IST on a business day (Mon-Fri): today, or the next business day when under two hours are left,
+  so the chase always lands after the request.
+
+Two jobs per hold, run by the job worker (D-003), which claims a job and calls the handler inside a transaction:
+- `approval.chase` one hour before the deadline: `on_chase` queues a `door.chase` reminder in the approver's
+  preferred door (identity_map.preferred_door) and audits it;
+- `approval.deadline` at the deadline: `on_deadline` leaves the action awaiting, opens a blocker on the case and
+  audits `approval.expired`. It never approves and never refuses: only a named person decides (§0 rule 2, D-005).
+  A decision that arrives later still counts, and clears the overdue blocker (the runner's Approve stage).
+"""
+
+from __future__ import annotations
+
+import re
+from datetime import UTC, date, datetime, time, timedelta, timezone
+from uuid import UUID
+
+from psycopg import AsyncConnection
+
+from contextrail import repo
+from contextrail.audit import chain
+from contextrail.models import ActionState, CaseFile, RunStatus
+from contextrail.policy.approvers import is_unresolved
+from contextrail.policy.schema import Rule
+from contextrail.rail.store import load_case, save_case
+
+IST = timezone(timedelta(hours=5, minutes=30), "IST")   # fixed offset: India has no daylight saving time
+END_OF_BUSINESS = time(17, 0)
+CHASE_BEFORE = timedelta(hours=1)
+MIN_WINDOW = timedelta(hours=2)
+OVERDUE_PREFIX = "Approval overdue: "
+_UNITS = {"m": "minutes", "h": "hours", "d": "days"}
+
+
+class RunBusy(Exception):
+    """The run is being resumed right now. Retry the job shortly (the worker's fail_job does)."""
+
+
+def parse_duration(value: str) -> timedelta:
+    """'30m' / '4h' / '90d', the format policy/schema.py validates for expires_after."""
+    m = re.fullmatch(r"(\d+)([mhd])", value)
+    if m is None:
+        raise ValueError(f"not a duration: {value!r}")
+    return timedelta(**{_UNITS[m[2]]: int(m[1])})
+
+
+def approval_deadline(now: datetime, rule: Rule | None) -> datetime:
+    """When a decision is due, in UTC."""
+    if rule is not None and rule.expires_after:
+        return now + parse_duration(rule.expires_after)
+    day: date = now.astimezone(IST).date()
+    while True:
+        eob = datetime.combine(day, END_OF_BUSINESS, tzinfo=IST)
+        if day.weekday() < 5 and eob - now >= MIN_WINDOW:
+            return eob.astimezone(UTC)
+        day += timedelta(days=1)
+
+
+def chase_time(deadline: datetime, now: datetime) -> datetime | None:
+    """One hour before the deadline; None when that is already past (the approval request itself just went out)."""
+    at = deadline - CHASE_BEFORE
+    return at if at > now else None
+
+
+async def schedule(conn: AsyncConnection, case: CaseFile, *, rules: list[Rule],
+                   now: datetime | None = None) -> dict[str, datetime]:
+    """Give each new hold its deadline (on the action, in place) and enqueue its deadline and chase jobs, once.
+    Holds without a named approver are blockers (approve.dispatch_holds), not something to chase."""
+    now = now or datetime.now(UTC)
+    by_id = {r.id: r for r in rules}
+    out: dict[str, datetime] = {}
+    for a in case.actions:
+        if a.state is not ActionState.AWAITING or is_unresolved(a.approver) or a.expires_at is not None:
+            continue
+        a.expires_at = deadline = approval_deadline(now, by_id.get(a.rule_id or ""))
+        payload = {"run_id": str(case.run_id), "action_id": a.id, "params_hash": a.params_hash,
+                   "approver": a.approver, "deadline": deadline.isoformat()}
+        await repo.enqueue_job(conn, "approval.deadline", payload, run_at=deadline,
+                               dedupe_key=f"approval.deadline:{case.run_id}:{a.id}")
+        if chase := chase_time(deadline, now):
+            await repo.enqueue_job(conn, "approval.chase", payload, run_at=chase,
+                                   dedupe_key=f"approval.chase:{case.run_id}:{a.id}")
+        out[a.id] = deadline
+    return out
+
+
+# --- job handlers ---------------------------------------------------------------------------------------------
+
+async def _still_waiting(conn: AsyncConnection, run_id: UUID, payload: dict) -> tuple[str | None, dict | None]:
+    """(reason to stop, action row). A decision, a moved-on action or changed parameters end the job quietly."""
+    if await repo.get_approval(conn, run_id, payload["action_id"]):
+        return "decided", None
+    action = await (await conn.execute("select * from actions where run_id = %s and id = %s",
+                                       (run_id, payload["action_id"]))).fetchone()
+    if action is None or action["state"] != ActionState.AWAITING:
+        return "not_awaiting", None
+    if action["params_hash"] != payload["params_hash"]:
+        return "stale", None
+    return None, action
+
+
+async def _person(conn: AsyncConnection, person_id: str) -> dict | None:
+    return await (await conn.execute("select display_name, preferred_door from identity_map where person_id = %s",
+                                     (person_id,))).fetchone()
+
+
+async def on_chase(conn: AsyncConnection, payload: dict, *, now: datetime | None = None) -> str:
+    """approval.chase: remind the approver in their preferred door. Returns what happened."""
+    now = now or datetime.now(UTC)
+    run_id = UUID(payload["run_id"])
+    stop, action = await _still_waiting(conn, run_id, payload)
+    if stop:
+        return stop
+    if action["expires_at"] is None or now >= action["expires_at"]:
+        return "past_deadline"
+    person = await _person(conn, action["approver"])
+    if person is None:
+        await chain.append(conn, run_id=run_id, event="approval.chase_failed",
+                           payload={"action_id": action["id"], "approver": action["approver"],
+                                    "reason": "approver has no identity, so no door to chase in"})
+        return "no_door"
+    channel, deadline = person["preferred_door"], action["expires_at"].isoformat()
+    await repo.enqueue_job(conn, "door.chase", {"run_id": str(run_id), "action_id": action["id"],
+                                                "params_hash": action["params_hash"], "approver": action["approver"],
+                                                "channel": channel, "deadline": deadline},
+                           dedupe_key=f"door.chase:{run_id}:{action['id']}:{channel}")
+    await chain.append(conn, run_id=run_id, event="approval.chased",
+                       payload={"action_id": action["id"], "approver": action["approver"], "channel": channel,
+                                "deadline": deadline})
+    return "chased"
+
+
+def overdue_blocker(action_id: str, label: str, approver: str, deadline: datetime) -> str:
+    due = deadline.astimezone(IST).strftime("%Y-%m-%d %H:%M IST")
+    return (f"{OVERDUE_PREFIX}{action_id} ({label}) was due from {approver} by {due}. It is still awaiting a "
+            "decision; nothing was approved or refused automatically.")
+
+
+def is_overdue_blocker(blocker: str, action_id: str) -> bool:
+    return blocker.startswith(f"{OVERDUE_PREFIX}{action_id} ")
+
+
+def clear_overdue(blockers: list[str], decided: list[str]) -> list[str]:
+    """A named person has now decided these actions, so their overdue blockers are resolved."""
+    return [b for b in blockers if not any(is_overdue_blocker(b, aid) for aid in decided)]
+
+
+async def on_deadline(conn: AsyncConnection, payload: dict, *, now: datetime | None = None) -> str:
+    """approval.deadline: if nobody decided in time, open a blocker and audit it. Never decides. Returns what
+    happened. Takes the run row lock, so it cannot interleave with a resume re-sealing the same capsule."""
+    now = now or datetime.now(UTC)
+    run_id = UUID(payload["run_id"])
+    run = await (await conn.execute("select status from runs where id = %s for update", (run_id,))).fetchone()
+    if run is None:
+        return "not_awaiting"
+    stop, action = await _still_waiting(conn, run_id, payload)
+    if stop:
+        return stop
+    if action["expires_at"] is None or now < action["expires_at"]:
+        return "not_due"
+    if run["status"] == RunStatus.RUNNING:
+        raise RunBusy(f"run {run_id} is being resumed; retry the deadline for {action['id']}")
+    if run["status"] != RunStatus.AWAITING_APPROVAL:
+        return "not_awaiting"
+    case = await load_case(conn, run_id)
+    if any(is_overdue_blocker(b, action["id"]) for b in case.open_blockers):
+        return "already_expired"
+    person = await _person(conn, action["approver"])
+    t = action["target"]
+    blocker = overdue_blocker(action["id"], t.get("label") or t.get("entitlement") or action["id"],
+                              person["display_name"] if person else action["approver"], action["expires_at"])
+    await save_case(conn, case.model_copy(update={"open_blockers": [*case.open_blockers, blocker]}))
+    await chain.append(conn, run_id=run_id, event="approval.expired",
+                       payload={"action_id": action["id"], "approver": action["approver"],
+                                "params_hash": action["params_hash"], "deadline": action["expires_at"].isoformat(),
+                                "outcome": "still awaiting", "blocker": blocker})
+    return "expired"
