diff --git a/engine/contextrail/rail/reconcile.py b/engine/contextrail/rail/reconcile.py
new file mode 100644
index 0000000..7ab5790
--- /dev/null
+++ b/engine/contextrail/rail/reconcile.py
@@ -0,0 +1,211 @@
+"""Refund reconciliation, `refund.reconcile` (CLAUDE.md §14.2, checklist T207): the finance half of the same rail.
+
+Discover has found one customer account by exact id. From there the stages are the rail's own, in the same order,
+with the same seal, audit events and stage events; only what Compile gathers and which candidates Govern judges are
+finance-specific:
+
+- Compile: the customer record and the credit promises on its Freshdesk tickets (records), each ticket's prose
+  (untrusted, P6), the customer's Dodo payments with every refund on them (records), and the refund policy text.
+- Candidates are computed by code from records only. A promise still owed against a succeeded payment becomes one
+  `refund` action. A mismatch becomes an open blocker, and nothing executes while one is open (§8):
+    * promised but not paid: the promise names a payment that did not succeed (nothing to refund against), or the
+      ticket says "credited" while Dodo holds no refund for it;
+    * paid twice: two or more refunds on Dodo carry the same promise;
+    * paid a different amount: the one refund for a promise does not match the promised amount.
+  A promise refunded exactly once is settled and skipped.
+- Govern: POL-REF-001 (amount limit, Finance approval) and POL-REF-002 (one outage credit per customer per quarter)
+  read the target fields documented in docs/DECISIONS.md D-017, like every rule, through the same engine.
+- Execute / Verify: the Dodo connector writes the refund with the run's idempotency key and reads it back.
+"""
+
+from __future__ import annotations
+
+import time
+from collections import Counter
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from uuid import UUID
+
+from contextrail.models import Action, CaseFile, Evidence, RunStatus, Stage, check_stage_order
+from contextrail.rail import compile as compile_
+from contextrail.rail import finalize, govern, plan
+from contextrail.rail.store import save_case
+
+INTENTS = frozenset({"refund.reconcile"})
+_POLICY_PREFIXES = ("POL-REF-", "POL-SOD-")
+
+
+@dataclass(frozen=True)
+class FinanceInputs:
+    customer: dict           # the customer account record (Freshdesk)
+    promises: list[dict]     # credit promises on the customer's tickets (Freshdesk)
+    payments: list[dict]     # the customer's Dodo payments, each with every refund on it
+    dodo_label: str          # "LIVE · test mode" | "FIXTURE": printed wherever these records are shown
+    dodo_environment: str    # "test_mode" | "fixture"
+
+
+async def gather(customer: dict, *, customers, dodo) -> FinanceInputs:
+    promises = await customers.promises(customer["source_id"])
+    payments = await dodo.customer_payments(customer["dodo_customer_id"])
+    return FinanceInputs(customer=customer, promises=promises, payments=payments, dodo_label=dodo.label,
+                         dodo_environment=dodo.environment)
+
+
+def quarter_of(ts: str) -> str:
+    d = datetime.fromisoformat(ts)
+    return f"{d.year}-Q{(d.month - 1) // 3 + 1}"
+
+
+def money(amount_minor: int, currency: str) -> str:
+    return f"${amount_minor / 100:,.2f}" if currency == "USD" else f"{currency} {amount_minor / 100:,.2f}"
+
+
+def _meta(refund: dict) -> dict:
+    return refund.get("metadata") or {}
+
+
+def candidates(inputs: FinanceInputs, *, run_id: UUID | str) -> tuple[list[Action], list[str]]:
+    """Refund candidates and mismatch blockers, from records only. Promises are taken in incident order, so when
+    two outage credits fall in one quarter, the later one is the one counted as the duplicate."""
+    payments = {p["payment_id"]: p for p in inputs.payments}
+    refunds = [r for p in inputs.payments for r in p["refunds"] if r["status"] != "failed"]
+    outage_credits = Counter(_meta(r).get("quarter") for r in refunds if _meta(r).get("credit_type") == "outage")
+    name, account = inputs.customer["display_name"], inputs.customer["source_id"]
+    actions: list[Action] = []
+    mismatches: list[str] = []
+    live = [p for p in inputs.promises if p["status"] in ("promised", "credited")]
+    for pr in sorted(live, key=lambda p: (p["incident_started_at"], p["ticket_id"])):
+        ticket, amount, cur = pr["ticket_id"], pr["amount_minor"], pr["currency"]
+        paid = [r for r in refunds if _meta(r).get("promise_ref") == ticket]
+        payment = payments.get(pr["payment_id"])
+        if len(paid) > 1:
+            ids = ", ".join(r["refund_id"] for r in paid)
+            total = money(sum(r["amount"] for r in paid), cur)
+            mismatches.append(f"Paid twice: {ticket} promised {money(amount, cur)} to {name}, and Dodo holds "
+                              f"{len(paid)} refunds for it ({ids}), {total} in total. Recover or confirm before "
+                              "anything else is paid.")
+            continue
+        if len(paid) == 1:
+            r = paid[0]
+            if (r["amount"], r["currency"]) != (amount, cur):
+                mismatches.append(f"Paid a different amount: {ticket} promised {money(amount, cur)} to {name}, but "
+                                  f"refund {r['refund_id']} paid {money(r['amount'], r['currency'])}.")
+            continue  # settled: paid exactly once, for the promised amount
+        if pr["status"] == "credited":
+            mismatches.append(f"Promised but not paid: {ticket} is marked credited in Freshdesk, but Dodo holds no "
+                              f"refund for it ({money(amount, cur)} to {name}).")
+            continue
+        if payment is None or payment["status"] != "succeeded":
+            state = f"{pr['payment_id']} is {payment['status']}" if payment else f"{pr['payment_id']} is not on Dodo"
+            mismatches.append(f"Promised but not paid: {ticket} promises {money(amount, cur)} to {name} against a "
+                              f"payment that never succeeded ({state}), so there is nothing to refund. A person "
+                              "must decide how to honour it.")
+            continue
+        quarter = quarter_of(pr["incident_started_at"])
+        outage = pr["credit_type"] == "outage"
+        target = {
+            "system": "dodo", "run_id": str(run_id), "account_id": account,
+            "customer_id": inputs.customer["dodo_customer_id"], "payment_id": payment["payment_id"],
+            "item_id": (payment.get("product_cart") or [{}])[0].get("product_id"),
+            "amount_minor": amount, "currency": cur,
+            **({"amount_usd": round(amount / 100, 2)} if cur == "USD" else {}),
+            "credit_type": pr["credit_type"], "quarter": quarter,
+            "prior_outage_credits_in_quarter": outage_credits[quarter] if outage else 0,
+            "promise_ref": ticket, "incident_id": pr.get("incident_id"),
+            "label": f"Refund {money(amount, cur)} to {name} on {payment['payment_id']} "
+                     f"({pr['credit_type']} credit, {ticket})",
+        }
+        actions.append(Action.create(f"C{len(actions) + 1:02d}", "refund", target))
+        if outage:
+            outage_credits[quarter] += 1  # a second outage credit in this run counts the first
+    return actions, mismatches
+
+
+def finance_evidence(inputs: FinanceInputs, rules: list, now: datetime) -> list[Evidence]:
+    c = inputs.customer
+    ev = [Evidence(id=f"EV-fd-{c['source_id']}", kind="record", source="freshdesk",
+                   uri=f"freshdesk://companies/{c['source_id']}",
+                   excerpt=f"{c['display_name']}: customer {c['source_id']}, tier {c.get('tier')}, Dodo customer "
+                           f"{c['dodo_customer_id']}", retrieved_at=now, last_verified=now.date(), trust="record")]
+    for p in inputs.promises:
+        ev.append(Evidence(
+            id=f"EV-fd-{p['ticket_id']}", kind="record", source="freshdesk", uri=f"freshdesk://tickets/{p['ticket_id']}",
+            excerpt=f"{p['ticket_id']}: {p['status']} {p['credit_type']} credit {money(p['amount_minor'], p['currency'])} "
+                    f"on {p['payment_id']}, incident {p.get('incident_id')} ({quarter_of(p['incident_started_at'])})",
+            retrieved_at=now, last_verified=now.date(), trust="record"))
+        ev.append(Evidence(  # what a person wrote on the ticket: data, never instructions (P6)
+            id=f"EV-fd-{p['ticket_id']}-text", kind="document", source="freshdesk",
+            uri=f"freshdesk://tickets/{p['ticket_id']}#description",
+            excerpt=f"{p.get('subject', '')}\n{p.get('description', '')}".strip(), retrieved_at=now, trust="untrusted"))
+    for pay in inputs.payments:
+        paid = "; ".join(f"{r['refund_id']} {money(r['amount'], r['currency'])} {r['status']}"
+                         f" ({_meta(r).get('promise_ref', 'no promise ref')})" for r in pay["refunds"]) or "none"
+        ev.append(Evidence(
+            id=f"EV-dodo-{pay['payment_id']}", kind="record", source="dodo",
+            uri=f"dodo://{inputs.dodo_environment}/payments/{pay['payment_id']}",
+            excerpt=f"{pay['payment_id']}: {pay['status']}, {money(pay['total_amount'], pay['currency'])} on "
+                    f"{pay['created_at'][:10]}; refunds: {paid}", retrieved_at=now, last_verified=now.date(),
+            trust="record"))
+    ev += [compile_._policy_evidence(r, now) for r in rules if r.id.startswith(_POLICY_PREFIXES)]
+    return ev
+
+
+def _constraints(inputs: FinanceInputs) -> list[str]:
+    return [f"Refunds go through Dodo ({inputs.dodo_label}), only against succeeded payments, at most the amount "
+            "promised on the ticket.",
+            "Amounts and payments come from the ticket's fields and Dodo's records, never from ticket text."]
+
+
+async def run_after_discover(runner, run_id: UUID, row: dict, found) -> RunStatus:
+    """Compile -> Govern -> Plan for a reconciliation, then the rail's own Handoff and Approve..Finalize."""
+    d = runner.d
+    prev = check_stage_order(Stage.DISCOVER, Stage.COMPILE)
+    t0 = time.perf_counter()
+    now = datetime.now(UTC)
+    inputs = await gather(found.subject_record, customers=d.registry.get("customers"), dodo=d.registry.get("dodo"))
+    actions, mismatches = candidates(inputs, run_id=run_id)
+    evidence, stale = compile_.mark_stale(finance_evidence(inputs, d.rules, now))
+    case = CaseFile(run_id=run_id, request_text=row["request_text"], intent=found.intent.intent,
+                    subject=found.subject, evidence=evidence, constraints=_constraints(inputs),
+                    open_blockers=[*stale, *mismatches])
+    untrusted = sum(e.trust == "untrusted" for e in evidence)
+    async with d.db.transaction() as c:
+        case = await save_case(c, case, stage=Stage.COMPILE)
+        await runner._audit(c, run_id, "stage.compile", {
+            "evidence": len(evidence), "untrusted": untrusted, "blockers": case.open_blockers,
+            "mismatches": mismatches, "promises": [p["ticket_id"] for p in inputs.promises],
+            "payments": [p["payment_id"] for p in inputs.payments], "dodo": inputs.dodo_label,
+            "digest": case.digest, "ms": int((time.perf_counter() - t0) * 1000)})
+    await runner._emit(run_id, Stage.COMPILE, RunStatus.RUNNING,
+                       f"Case file sealed: {len(inputs.promises)} promised credits, {len(inputs.payments)} payments,"
+                       f" {len(mismatches)} mismatches", case)
+
+    prev = check_stage_order(prev, Stage.GOVERN)
+    governed = govern.evaluate(actions, case.subject, d.engine, role={}, requested_by=row["requested_by"])
+    case = case.model_copy(update={"actions": [g.action for g in governed]})
+    async with d.db.transaction() as c:
+        case = await save_case(c, case, stage=Stage.GOVERN)
+        await runner._sync_actions(c, case)
+        await runner._audit(c, run_id, "stage.govern", {
+            "verdicts": {g.action.id: [g.verdict.verdict, g.verdict.rule_id] for g in governed}, "digest": case.digest})
+    t = finalize.tally(case)
+    await runner._emit(run_id, Stage.GOVERN, RunStatus.RUNNING,
+                       f"Govern: {t['allow']} allowed, {t['hold']} held, {t['refuse']} refused", case)
+
+    prev = check_stage_order(prev, Stage.PLAN)
+    ordered = sorted(governed, key=plan._rank)
+    case = case.model_copy(update={"actions": [g.action for g in ordered],
+                                   "decisions": plan.explanations(ordered, d.explainer)})
+    async with d.db.transaction() as c:
+        case = await save_case(c, case, stage=Stage.PLAN)
+        await runner._sync_actions(c, case)
+        await runner._audit(c, run_id, "stage.plan", {"order": [a.id for a in case.actions],
+                                                      "decisions": case.decisions, "digest": case.digest})
+    await runner._emit(run_id, Stage.PLAN, RunStatus.RUNNING, f"Plan: {len(case.actions)} refunds, refusals kept",
+                       case)
+
+    check_stage_order(prev, Stage.HANDOFF)
+    sealed = await runner._handoff(run_id)
+    if sealed is None:
+        return RunStatus.FAILED
+    return await runner._continue(run_id, sealed, Stage.HANDOFF)
