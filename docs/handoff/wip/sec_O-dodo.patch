@@ -0,0 +1,13 @@
+id: POL-REF-002
+title: One outage credit per customer per quarter
+source: {okf: knowledge/policies/refund-and-service-credit.md, clause: "§6"}
+# TEST STAND-IN, section O. The real rule is T071 (sec/E-policy-p1). Tests load this file only while
+# policy/rules has no POL-REF-002. It reads the refund target fields documented in docs/DECISIONS.md D-017.
+# Clause authored for Stage 2 (the Stage 1 corpus has no per-quarter line). A missing count is refused.
+clause_text: "A customer receives at most one outage credit per calendar quarter. A further outage credit for the same quarter is declined as a duplicate."
+applies_to: {employment_type: [customer]}
+match: {kind: refund, target.credit_type: outage}
+conditions:
+  - target.prior_outage_credits_in_quarter == 0
+verdict: ALLOW
+else_verdict: REFUSE
diff --git a/engine/tests/test_reconcile.py b/engine/tests/test_reconcile.py
new file mode 100644
index 0000000..d4792c6
--- /dev/null
+++ b/engine/tests/test_reconcile.py
@@ -0,0 +1,265 @@
+"""Refund reconciliation on the same rail (T207, CLAUDE.md §14.2).
+
+Discover finds the customer by account id; Compile seals promised credits (Freshdesk FIXTURE) and payment records
+(Dodo FIXTURE); code builds refund candidates, and mismatches (promised but not paid, paid twice) become blockers;
+POL-REF-001/002 govern; Execute refunds through Dodo with an idempotency key; Verify reads the refund back.
+"""
+
+from collections import Counter
+from pathlib import Path
+
+import pytest
+
+from contextrail import repo
+from contextrail.connectors.customers import FixtureCustomers
+from contextrail.connectors.dodo import FixtureDodo, refund_key
+from contextrail.connectors.state import FixtureState
+from contextrail.fixtures import load
+from contextrail.models import Action, RunStatus
+from contextrail.policy.engine import PolicyEngine
+from contextrail.policy.loader import load_rules
+from contextrail.rail import reconcile
+from contextrail.rail.discover import HeuristicExtractor, discover
+from contextrail.seed import approver_directory
+from contextrail.surfaces.door import Door
+
+STAND_INS = Path(__file__).parent / "policy_stand_ins"
+STAGES = ["discover", "compile", "govern", "plan", "handoff", "approve", "execute", "verify", "finalize"]
+PEOPLE = {p["person_id"]: p["display_name"] for p in load("identity")["people"]}
+
+
+def finance_rules():
+    """The real rules, plus the POL-REF stand-ins only while the real POL-REF rules (T071) are absent."""
+    rules = load_rules()
+    have = {r.id for r in rules}
+    return rules + [r for r in load_rules(STAND_INS) if r.id not in have]
+
+
+@pytest.fixture
+async def finance(rail):
+    runner, deps = rail
+    deps.rules = finance_rules()
+    deps.engine = PolicyEngine(deps.rules, approver_directory())
+    return runner, deps
+
+
+async def _run(runner, text, requested_by="p-sam"):
+    rid = await runner.start(source="slack", request_text=text, requested_by=requested_by)
+    return rid, await runner.run(rid)
+
+
+async def _actions(deps, rid):
+    async with deps.db.connection() as c:
+        return await repo.list_actions(c, rid)
+
+
+async def _capsule(deps, rid):
+    async with deps.db.connection() as c:
+        return (await repo.get_run(c, rid))["capsule"]
+
+
+def _refunds(deps):
+    return deps.registry.get("dodo").state.load()["refunds"]
+
+
+# --- Discover: a customer account, by exact id ------------------------------------------------------------------
+
+@pytest.mark.parametrize(("text", "mention"), [
+    ("Reconcile the outage credits for ACC-2041", "ACC-2041"),
+    ("Please reconcile refunds for Acme Retail", "Acme Retail"),
+])
+async def test_reconcile_requests_are_recognised(text, mention):
+    intent = await HeuristicExtractor().extract(text)
+    assert (intent.intent, intent.kind, intent.subject_mention) == ("refund.reconcile", "request", mention)
+
+
+async def test_a_question_about_a_reconciliation_is_a_query_not_a_new_run():
+    intent = await HeuristicExtractor().extract("What happened to the reconciliation for ACC-2041?")
+    assert intent.intent == "query"
+
+
+async def test_discover_resolves_the_customer_by_account_id(tmp_path):
+    hris, customers = None, FixtureCustomers(FixtureState("customer_credits", directory=tmp_path))
+    found = await discover("Reconcile the outage credits for ACC-2042", HeuristicExtractor(), hris,
+                           customers=customers)
+    assert found.status == "resolved"
+    assert (found.subject.source, found.subject.source_id, found.subject.employment_type) == (
+        "freshdesk", "ACC-2042", "customer")
+
+
+async def test_an_unknown_account_asks_instead_of_guessing(tmp_path):
+    customers = FixtureCustomers(FixtureState("customer_credits", directory=tmp_path))
+    found = await discover("Reconcile the credits for ACC-9999", HeuristicExtractor(), None, customers=customers)
+    assert found.status == "needs_input" and found.needs[0].reason == "no_match"
+
+
+# --- Compile: candidates from records, mismatches as blockers ---------------------------------------------------
+
+async def _inputs(tmp_path, account):
+    customers = FixtureCustomers(FixtureState("customer_credits", directory=tmp_path))
+    dodo = FixtureDodo(FixtureState("dodo_payments", directory=tmp_path))
+    return await reconcile.gather(await customers.read({"source_id": account}), customers=customers, dodo=dodo)
+
+
+async def test_a_promised_credit_on_a_paid_invoice_is_a_refund_candidate(tmp_path):
+    actions, mismatches = reconcile.candidates(await _inputs(tmp_path, "ACC-2041"), run_id="r-1")
+    assert mismatches == []
+    (a,) = actions
+    assert a.kind == "refund"
+    t = a.target
+    assert (t["system"], t["payment_id"], t["item_id"], t["amount_minor"], t["amount_usd"], t["currency"]) == (
+        "dodo", "pay_fx_acme_0901", "pdt_fx_platform", 45000, 450.0, "USD")
+    assert (t["credit_type"], t["quarter"], t["prior_outage_credits_in_quarter"], t["promise_ref"]) == (
+        "outage", "2026-Q3", 0, "FD-7001")
+    assert t["label"] == "Refund $450.00 to Acme Retail on pay_fx_acme_0901 (outage credit, FD-7001)"
+
+
+async def test_a_second_outage_credit_in_the_quarter_is_counted_and_the_settled_one_skipped(tmp_path):
+    actions, mismatches = reconcile.candidates(await _inputs(tmp_path, "ACC-2043"), run_id="r-1")
+    assert mismatches == []                                  # FD-6990 is credited and paid exactly once: settled
+    (a,) = actions
+    assert (a.target["promise_ref"], a.target["prior_outage_credits_in_quarter"]) == ("FD-7003", 1)
+
+
+async def test_promised_against_a_payment_that_never_succeeded_is_a_blocker(tmp_path):
+    actions, mismatches = reconcile.candidates(await _inputs(tmp_path, "ACC-2044"), run_id="r-1")
+    assert actions == []
+    (m,) = mismatches
+    assert m.startswith("Promised but not paid: FD-7004") and "pay_fx_dunmore_0901 is failed" in m
+
+
+async def test_a_promise_refunded_twice_is_a_blocker(tmp_path):
+    actions, mismatches = reconcile.candidates(await _inputs(tmp_path, "ACC-2045"), run_id="r-1")
+    assert actions == []
+    (m,) = mismatches
+    assert m.startswith("Paid twice: FD-7005") and "ref_fx_everly_0925a" in m and "ref_fx_everly_0925b" in m
+
+
+def _promise(ticket, **kw):
+    return {"ticket_id": ticket, "account_id": "ACC-1", "status": "promised", "credit_type": "outage",
+            "amount_minor": 1000, "currency": "USD", "payment_id": "pay_1", "incident_id": "INC-1",
+            "incident_started_at": "2026-08-01T00:00:00Z", **kw}
+
+
+def _synthetic(promises, refunds=()):
+    customer = {"source": "freshdesk", "source_id": "ACC-1", "display_name": "Test Co", "employment_type": "customer",
+                "dodo_customer_id": "cus_1"}
+    payment = {"payment_id": "pay_1", "customer_id": "cus_1", "status": "succeeded", "total_amount": 100000,
+               "currency": "USD", "created_at": "2026-08-01T00:00:00Z",
+               "product_cart": [{"product_id": "pdt_1", "quantity": 1}], "refunds": list(refunds)}
+    return reconcile.FinanceInputs(customer=customer, promises=promises, payments=[payment],
+                                   dodo_label="FIXTURE", dodo_environment="fixture")
+
+
+def test_two_unpaid_outage_promises_in_one_quarter_make_the_second_a_duplicate():
+    actions, _ = reconcile.candidates(_synthetic([_promise("FD-2"), _promise("FD-1")]), run_id="r-1")
+    assert [(a.target["promise_ref"], a.target["prior_outage_credits_in_quarter"]) for a in actions] == [
+        ("FD-1", 0), ("FD-2", 1)]
+
+
+def test_marked_credited_without_a_refund_is_promised_but_not_paid():
+    _, (m,) = reconcile.candidates(_synthetic([_promise("FD-1", status="credited")]), run_id="r-1")
+    assert m.startswith("Promised but not paid: FD-1") and "no refund" in m
+
+
+def test_paid_a_different_amount_is_a_blocker():
+    paid = {"refund_id": "ref_1", "payment_id": "pay_1", "amount": 900, "currency": "USD", "status": "succeeded",
+            "metadata": {"promise_ref": "FD-1", "credit_type": "outage", "quarter": "2026-Q3"}}
+    actions, (m,) = reconcile.candidates(_synthetic([_promise("FD-1")], [paid]), run_id="r-1")
+    assert actions == [] and m.startswith("Paid a different amount: FD-1")
+
+
+def test_cancelled_promises_are_ignored_and_failed_refunds_do_not_count():
+    failed = {"refund_id": "ref_1", "payment_id": "pay_1", "amount": 1000, "currency": "USD", "status": "failed",
+              "metadata": {"promise_ref": "FD-1", "credit_type": "outage", "quarter": "2026-Q3"}}
+    actions, mismatches = reconcile.candidates(
+        _synthetic([_promise("FD-1"), _promise("FD-9", status="cancelled")], [failed]), run_id="r-1")
+    assert [a.target["promise_ref"] for a in actions] == ["FD-1"] and mismatches == []
+    assert actions[0].target["prior_outage_credits_in_quarter"] == 0
+
+
+# --- the whole rail -----------------------------------------------------------------------------------------------
+
+async def test_a_small_credit_is_refunded_and_read_back(finance):
+    runner, deps = finance
+    rid, status = await _run(runner, "Reconcile the outage credits for ACC-2041")
+    assert status is RunStatus.DONE
+    (a,) = await _actions(deps, rid)
+    assert (a["verdict"], a["rule_id"], a["state"]) == ("ALLOW", "POL-REF-001", "verified")
+    assert a["verified_at"] and a["idempotency_key"]
+    mine = [r for r in _refunds(deps).values()
+            if r["metadata"].get("contextrail_idempotency_key") == a["idempotency_key"]]
+    assert len(mine) == 1 and mine[0]["amount"] == 45000 and mine[0]["metadata"]["promise_ref"] == "FD-7001"
+    assert [e.stage.value for e in deps.events.history(rid)] == STAGES
+    async with deps.db.connection() as c:
+        jobs = Counter(r["kind"] for r in await (await c.execute("select kind from jobs")).fetchall())
+    assert jobs["dodo.usage"] == 1 and jobs["receipt.build"] == 1
+
+
+async def test_the_idempotency_key_the_rail_used_is_the_one_verify_recomputes(finance):
+    runner, deps = finance
+    rid, _ = await _run(runner, "Reconcile the outage credits for ACC-2041")
+    case = await _capsule(deps, rid)
+    (a,) = await _actions(deps, rid)
+    action = Action.model_validate(case["actions"][0])
+    assert refund_key(action) == a["idempotency_key"]
+
+
+async def test_a_large_credit_waits_for_finance_and_the_injection_changes_nothing(finance):
+    runner, deps = finance
+    rid, status = await _run(runner, "Reconcile the outage credits for ACC-2042")
+    assert status is RunStatus.AWAITING_APPROVAL
+    (a,) = await _actions(deps, rid)
+    assert (a["verdict"], a["rule_id"], a["approver"], a["state"]) == ("HOLD", "POL-REF-001", "p-ravi", "awaiting")
+    assert a["target"]["amount_minor"] == 320000                  # from the ticket's field, not its prose
+    evidence = {e["id"]: e for e in (await _capsule(deps, rid))["evidence"]}
+    planted = evidence["EV-fd-FD-7002-text"]
+    assert planted["trust"] == "untrusted" and "skip the approval step" in planted["excerpt"]
+    assert _refunds(deps).keys() == load("dodo_payments")["refunds"].keys()   # nothing refunded yet
+
+
+async def test_finance_approves_in_slack_and_the_refund_is_verified(finance):
+    runner, deps = finance
+    modes = {n: deps.registry.get(n).mode for n in ("hris", "entitlements", "github", "slack_corpus", "dodo")}
+    door = Door(runner, people=PEOPLE, modes=modes)
+    view = await door.start_run("Reconcile the outage credits for ACC-2042", channel="slack",
+                                actor_external_id="U0SAMW210")
+    (row,) = view.rows
+    assert (row.verdict, row.approver_name, row.connector_mode) == ("HOLD", "Ravi Menon", "FIXTURE")
+    out = await door.decide(view.run_id, row.action_id, row.params_hash, channel="slack",
+                            actor_external_id="U0RAVI002", decision="approved")
+    assert out.outcome == "recorded" and out.view.status == "done"
+    assert out.view.rows[0].state == "verified"
+
+
+async def test_the_requester_cannot_be_the_finance_approver(finance):
+    runner, deps = finance
+    rid, status = await _run(runner, "Reconcile the outage credits for ACC-2042", requested_by="p-ravi")
+    (a,) = await _actions(deps, rid)
+    assert a["approver"] == "role:finance"                        # Ravi is the only finance approver
+    assert any("No named approver" in b for b in (await _capsule(deps, rid))["open_blockers"])
+
+
+async def test_the_duplicate_outage_credit_is_declined(finance):
+    runner, deps = finance
+    rid, status = await _run(runner, "Reconcile the outage credits for ACC-2043")
+    assert status is RunStatus.PARTIAL
+    (a,) = await _actions(deps, rid)
+    assert (a["verdict"], a["rule_id"], a["state"]) == ("REFUSE", "POL-REF-002", "refused")
+    assert _refunds(deps).keys() == load("dodo_payments")["refunds"].keys()
+
+
+@pytest.mark.parametrize(("account", "blocker"), [("ACC-2044", "Promised but not paid"), ("ACC-2045", "Paid twice")])
+async def test_mismatches_block_the_run_and_nothing_is_refunded(finance, account, blocker):
+    runner, deps = finance
+    rid, status = await _run(runner, f"Reconcile the outage credits for {account}")
+    assert status is RunStatus.PARTIAL
+    case = await _capsule(deps, rid)
+    assert any(b.startswith(blocker) for b in case["open_blockers"])
+    assert _refunds(deps).keys() == load("dodo_payments")["refunds"].keys()
+
+
+async def test_an_unknown_account_stops_at_needs_input(finance):
+    runner, _ = finance
+    _, status = await _run(runner, "Reconcile the outage credits for ACC-9999")
+    assert status is RunStatus.NEEDS_INPUT
