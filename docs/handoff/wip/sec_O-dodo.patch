@@ -0,0 +1,14 @@
+id: POL-REF-001
+title: Refunds up to the Support limit are issued; above it Finance approves
+source: {okf: knowledge/policies/refund-and-service-credit.md, clause: "§3"}
+# TEST STAND-IN, section O. The real rule is T071 (sec/E-policy-p1). Tests load this file only while
+# policy/rules has no POL-REF-001, so once T071 merges the reconciliation tests run against the real rule.
+# It reads the refund target fields documented in docs/DECISIONS.md D-017. Clause: Stage 1 corpus
+# ntn_refund_policy §3, verbatim. Unknown or non-USD amounts fail the condition and are refused.
+clause_text: "Credits at or below $2,000 may be issued by Support. Credits above $2,000 require Finance approval. Credits above $10,000 require VP Finance sign-off."
+match: {kind: refund}
+conditions:
+  - target.amount_usd > 0
+verdict: ALLOW
+escalate: {when: "target.amount_usd > 2000", verdict: HOLD, approver: finance}
+else_verdict: REFUSE
