+"""Customer accounts and promised credits (checklist T207), FIXTURE until a Freshdesk tenant exists (T003).
+
+Read-only. Customers are looked up exactly: by account id, or by exact full name returning every match, never a
+best guess (P1). A promise is a Freshdesk ticket on which support promised a service credit. Its structured fields
+(amount_minor, currency, payment_id, incident, status) are the record that reconciliation uses; its subject and
+description are what a person wrote and are only ever untrusted evidence (P6).
+"""
+
+from __future__ import annotations
+
+from contextrail.connectors.base import ConnectorError, WriteResult
+from contextrail.connectors.state import FixtureState
+from contextrail.models import Action
+
+
+class FixtureCustomers:
+    name = "customers"
+    mode = "FIXTURE"
+    system = "freshdesk"
+
+    def __init__(self, state: FixtureState | None = None) -> None:
+        self.state = state or FixtureState("customer_credits")
+
+    async def read(self, ref: dict) -> dict:
+        for c in self.state.load()["customers"]:
+            if c["source_id"] == ref.get("source_id"):
+                return dict(c)
+        raise ConnectorError(f"no customer account {ref.get('source_id')}")
+
+    async def find_by_name(self, name: str) -> list[dict]:
+        want = " ".join(name.split()).casefold()
+        return [dict(c) for c in self.state.load()["customers"] if c["display_name"].casefold() == want]
+
+    async def promises(self, account_id: str) -> list[dict]:
+        return [dict(p) for p in self.state.load()["promises"] if p["account_id"] == account_id]
+
+    async def write(self, action: Action, idem_key: str) -> WriteResult:
+        raise ConnectorError("customer connector is read-only")
+
+    async def verify(self, action: Action) -> tuple[bool, dict]:
+        raise ConnectorError("customer connector is read-only")
