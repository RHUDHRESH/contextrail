diff --git a/engine/tests/test_adversary.py b/engine/tests/test_adversary.py
new file mode 100644
index 0000000..2e65a2d
--- /dev/null
+++ b/engine/tests/test_adversary.py
@@ -0,0 +1,90 @@
+"""The adversary console: five attacks against a real run, each held by a real guarantee, reported honestly."""
+
+import uuid
+
+from contextrail import adversary
+from contextrail.audit.chain import verify_db
+
+ATTACKS = {"forged_approval", "stripped_constraint", "promoted_subject", "replayed_write", "ignore_policy"}
+
+
+async def _start(client, text="Give Anil the same access as Rahul Mehta", actor="U0ANIL001"):
+    r = await client.post("/v1/runs", json={"request_text": text, "channel": "slack", "actor_external_id": actor})
+    return r.json()
+
+
+async def _snapshot(platform, run_id):
+    async with platform.db.connection() as c:
+        states = {a["id"]: a["state"] for a in await (await c.execute(
+            "select id, state from actions where run_id = %s", (run_id,))).fetchall()}
+        approvals = (await (await c.execute("select count(*) as n from approvals where run_id = %s",
+                                            (run_id,))).fetchone())["n"]
+        digest = (await (await c.execute("select capsule_digest from runs where id = %s",
+                                         (run_id,))).fetchone())["capsule_digest"]
+    holdings = (await platform.registry.get("entitlements").read({"subject_id": "E-1042"}))["holdings"]
+    return states, approvals, digest, sorted(holdings)
+
+
+async def test_the_console_lists_the_five_attacks_with_the_claim_each_tests(api):
+    client, _ = api
+    listed = (await client.get("/v1/adversary")).json()
+    assert {a["id"] for a in listed} == ATTACKS and all(a["claim"] and a["attempt"] for a in listed)
+
+
+async def test_all_five_attacks_are_held_on_the_same_as_rahul_run_and_change_nothing(api):
+    client, platform = api
+    view = await _start(client)
+    before = await _snapshot(platform, view["run_id"])
+    r = await client.post(f"/v1/runs/{view['run_id']}/adversary")
+    assert r.status_code == 200
+    outcomes = {o["id"]: o for o in r.json()}
+    assert set(outcomes) == ATTACKS
+    assert {k: o["verdict"] for k, o in outcomes.items()} == dict.fromkeys(ATTACKS, "held"), outcomes
+    proof = {p["label"]: p["value"] for p in outcomes["forged_approval"]["proof"]}
+    assert "refuse_is_terminal" in proof["database"] and "rejected" in proof["door"]
+    assert "EV-slk_payments_admin_override" in str(outcomes["ignore_policy"]["proof"])
+    assert await _snapshot(platform, view["run_id"]) == before       # the attacks left the run as it was
+    async with platform.db.connection() as c:
+        events = [e["event"] for e in await (await c.execute(
+            "select event from audit where run_id = %s order by seq", (view["run_id"],))).fetchall()]
+        assert (await verify_db(c)).ok
+    assert events.count("adversary.attack") == 5 and "approval.rejected" in events
+
+
+async def test_the_contractor_run_holds_too(api):
+    client, _ = api
+    view = await _start(client, "Priya starts Monday, give her everything she needs", "U0MARC120")
+    outcomes = {o["id"]: o for o in (await client.post(f"/v1/runs/{view['run_id']}/adversary")).json()}
+    assert {k: o["verdict"] for k, o in outcomes.items()} == dict.fromkeys(ATTACKS, "held"), outcomes
+    stripped = {p["label"]: p["value"] for p in outcomes["stripped_constraint"]["proof"]}
+    assert "POL-CTR-001" in stripped["removed"]
+    promoted = {p["label"]: p["value"] for p in outcomes["promoted_subject"]["proof"]}
+    assert (promoted["forged"], promoted["system of record"]) == ("employment_type=employee",
+                                                                  "employment_type=contractor")
+
+
+async def test_one_attack_at_a_time_and_bad_requests(api):
+    client, _ = api
+    view = await _start(client)
+    one = await client.post(f"/v1/runs/{view['run_id']}/adversary/replayed_write")
+    assert one.status_code == 200 and one.json()["verdict"] == "held"
+    assert "idempotency key" in {p["label"] for p in one.json()["proof"]}
+    assert (await client.post(f"/v1/runs/{view['run_id']}/adversary/drop_tables")).status_code == 422
+    assert (await client.post(f"/v1/runs/{uuid.uuid4()}/adversary")).status_code == 404
+
+
+async def test_a_run_with_nothing_to_attack_says_so(api):
+    client, _ = api
+    view = await _start(client, "Give Anil the same access as Rahul")       # needs_input: nothing compiled
+    outcomes = {o["id"]: o for o in (await client.post(f"/v1/runs/{view['run_id']}/adversary")).json()}
+    assert {o["verdict"] for o in outcomes.values()} == {"not_applicable"}
+
+
+async def test_a_disabled_guarantee_is_reported_as_breached(api, monkeypatch):
+    client, _ = api
+    view = await _start(client)
+    monkeypatch.setattr(adversary, "receive", lambda payload: None)       # a handoff that no longer checks seals
+    outcomes = {o["id"]: o for o in (await client.post(f"/v1/runs/{view['run_id']}/adversary")).json()}
+    assert outcomes["stripped_constraint"]["verdict"] == "breached"
+    assert outcomes["promoted_subject"]["verdict"] == "breached"
+    assert outcomes["stripped_constraint"]["headline"].startswith("BREACH")
