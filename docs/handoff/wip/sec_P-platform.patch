+async def test_show(api):
+    client, _ = api
+    view = (await client.post("/v1/runs", json={"request_text": "Give Anil the same access as Rahul Mehta",
+                                                 "channel": "slack", "actor_external_id": "U0ANIL001"})).json()
+    for o in (await client.post(f"/v1/runs/{view['run_id']}/adversary")).json():
+        print(f"\n== {o['id']}: {o['verdict']} :: {o['headline']}")
+        for p in o["proof"]:
+            print(f"   {p['label']}: {p['value'][:150]}")
