+# --- listing -----------------------------------------------------------------------------------------------
+
+async def list_runs(conn: AsyncConnection, *, status: str | None = None, source: str | None = None,
+                    requested_by: str | None = None, subject_id: str | None = None, limit: int = 20) -> list[dict]:
+    """Runs, newest first, with verdict and verification counts from their actions. Every filter is optional."""
+    cur = await conn.execute("""
+        select r.id, r.status, r.stage, r.source, r.intent, r.request_text, r.subject_id, r.requested_by,
+               r.capsule_digest, r.created_at, r.updated_at,
+               count(a.id) filter (where a.verdict = 'ALLOW')  as allow,
+               count(a.id) filter (where a.verdict = 'HOLD')   as hold,
+               count(a.id) filter (where a.verdict = 'REFUSE') as refuse,
+               count(a.id) filter (where a.state = 'verified') as verified,
+               count(a.id) filter (where a.state = 'awaiting') as awaiting
+        from runs r left join actions a on a.run_id = r.id
+        where (%(status)s::text is null or r.status = %(status)s)
+          and (%(source)s::text is null or r.source = %(source)s)
+          and (%(requested_by)s::text is null or r.requested_by = %(requested_by)s)
+          and (%(subject_id)s::text is null or r.subject_id = %(subject_id)s)
+        group by r.id
+        order by r.created_at desc, r.id
+        limit %(limit)s""", {"status": status, "source": source, "requested_by": requested_by,
+                             "subject_id": subject_id, "limit": limit})
+    return await cur.fetchall()
