+# --- list_runs (T188) ---------------------------------------------------------------------------------------
+
+async def _two_runs(door) -> tuple[dict, dict]:
+    mcp_run = (await call(server(door), "compile_context_capsule",
+                          {"request_text": SAME_AS_RAHUL, **ANIL})).structured_content
+    slack_run = await door.start_run("Give Anil the same access as Rahul", channel="slack",
+                                     actor_external_id="U0ANIL001")          # ambiguous -> needs_input
+    return mcp_run, slack_run.model_dump(mode="json")
+
+
+async def test_list_runs_newest_first_with_handles_and_verdict_counts(door):
+    mcp_run, slack_run = await _two_runs(door)
+    out = (await call(server(door), "list_runs", {})).structured_content
+    assert [r["run_id"] for r in out["runs"]] == [slack_run["run_id"], mcp_run["run_id"]]
+    listed = out["runs"][1]
+    assert listed["capsule_handle"] == mcp_run["capsule_handle"] and listed["source"] == "mcp"
+    assert (listed["counts"]["hold"], listed["counts"]["refuse"]) == (2, 1)
+    assert listed["requested_by"] == "p-anil" and listed["subject_id"] == "E-1042"
+    assert out["runs"][0]["capsule_handle"] is None and out["runs"][0]["status"] == "needs_input"
+
+
+@pytest.mark.parametrize(("filters", "expect"), [
+    ({"status": "needs_input"}, ["slack"]),
+    ({"source": "mcp"}, ["mcp"]),
+    ({"requested_by": "p-anil"}, ["slack", "mcp"]),
+    ({"requested_by": "p-rahul"}, []),
+    ({"subject_id": "E-1042"}, ["mcp"]),
+    ({"limit": 1}, ["slack"]),
+])
+async def test_list_runs_filters(door, filters, expect):
+    await _two_runs(door)
+    out = (await call(server(door), "list_runs", filters)).structured_content
+    assert [r["source"] for r in out["runs"]] == expect
+
+
+async def test_list_runs_rejects_an_unknown_status(door):
+    r = await call(server(door), "list_runs", {"status": "approved-by-me"})
+    assert r.is_error
+
